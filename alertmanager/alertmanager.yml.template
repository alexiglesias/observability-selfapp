# TEMPLATE, not the live config. Alertmanager itself does NOT support
# ${VAR} substitution in its config file the way Docker Compose does —
# feeding it this file directly would leave the literal string
# "${SLACK_WEBHOOK_URL}" in slack_api_url and every notification would
# silently fail. See docker-compose.yml's `alertmanager-init` service,
# which renders this template into a real alertmanager.yml (with the
# actual webhook URL substituted in) on a shared volume, BEFORE
# alertmanager starts and reads it. The real webhook URL only ever
# exists in .env and in that runtime-generated file inside the
# alertmanager-config volume — never in a file tracked by Git.

global:
  resolve_timeout: 5m
  slack_api_url: ${SLACK_WEBHOOK_URL}

route:
  receiver: slack-default
  group_by: ["alertname", "instance"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 3h
  routes:
    - match:
        severity: critical
      receiver: slack-critical
      repeat_interval: 30m

receivers:
  - name: slack-default
    slack_configs:
      - channel: "#alerts"
        send_resolved: true
        title: '{{ .CommonAnnotations.summary }}'
        text: '{{ .CommonAnnotations.description }}'

  - name: slack-critical
    slack_configs:
      - channel: "#alerts"
        send_resolved: true
        title: ':rotating_light: {{ .CommonAnnotations.summary }}'
        text: '{{ .CommonAnnotations.description }}'
