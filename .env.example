# Copy to .env and fill in real values. .env is gitignored — never commit it.

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# Slack Incoming Webhook URL — see README "Slack setup" for how to get one.
# Looks like: https://hooks.slack.com/services/T000/B000/XXXXXXXXXXXXXXXX
SLACK_WEBHOOK_URL=CHANGE_ME


# Name of docker-buildlab-selfapp's Docker network: <its folder name>_self-net.
# Check with: docker network ls | grep self-net
SELFAPP_NETWORK=docker-buildlab-selfapp_self-net