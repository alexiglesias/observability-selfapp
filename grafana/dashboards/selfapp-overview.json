        }
      }
    },
    {
      "id": 19,
      "type": "row",
      "title": "Logs (Loki)",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 40
      }
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Log lines per minute",
      "description": "How much each container logs. A sudden jump often means errors.",
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 41
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "expr": "sum by (container) (count_over_time({container=~\"$container\"}[1m]))",
          "legendFormat": "{{container}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "drawStyle": "bars"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 21,
      "type": "logs",
      "title": "Logs",
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "description": "Container logs collected by Alloy. Use the 'container' and 'search' filters at the top.",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 47
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "expr": "{container=~\"$container\"} |~ \"(?i)$search\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ],
  "templating": {
    "list": [
      {
        "type": "custom",
        "name": "container",
        "label": "container",
        "query": "selfapp,selfweb,selfdb,selfmq",
        "multi": true,
        "includeAll": true,
        "allValue": "selfapp|selfweb|selfdb|selfmq",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
